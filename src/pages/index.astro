---
import Layout from "../layouts/Layout.astro";
import CopyButton from "../components/CopyButton.astro";
---

<Layout title="Home">
  <main>
    <div class="staff-row staff-full-content-width l-padding--top-xl l-padding--bottom-xl">
      <div class="content-block v-content-block--homepage">
        <div class="content-block__img-container">
          <figure>
            <img
              src="assets/img/tim-sit.jpg"
              alt="Professional, yet personable greyscale photo of Tim"
              class="content-block__header-img"
            />
          </figure>
        </div>
        <div class="content-block__body">
          <div class="content-block__body-title">
            <h1>
              <i>Hello,</i> I'm <span class="color--accent">.</span>tim<span
                class="color--accent">.</span
              >schletter
            </h1>
          </div>
          <div class="content-block__body-text">
            <h2>
              I'm a designer, artist, musician and a student of the creative
              process.
            </h2><p>I’m deeply curious about the creative process. When hyperfocus aligns with inspiration, I dive headfirst into the strategies, processes, and hands-on execution that bring ideas to life. Working at the crossroads of design and front-end development allows me to continually explore, understand, and improve the creative and visual systems that support thoughtful digital experiences.</p>
            <div class="show-mobile l-padding--bottom-l contact-cta">
            <h3>Contact</h3>
            <p>If you'd like to reach out to me, copy and paste the email address below.</p>
            <CopyButton />
          </div>
          <p>
              Check out <a
                href="//www.linkedin.com/in/schletter/"
                target="_blank">my LinkedIn</a
              > to learn more. And, here is <a
                href="assets/downloads/Tim-Schletter-Resume-rd.pdf"
                target="_blank">my résumé</a
              > for the nitty gritty.
            </p>
            <!-- <span class="ui-accent-line"></span> -->
          </div>
        </div>
      </div>
    </div>
    <!-- <div class="staff-row staff-slim-centered l-padding--bottom-xxl">
        <figure class="homepage-illustration">
              <img src="/assets/img/art/illuclump-01.png" alt="Illustration Clump" class="" />
              <figcaption>A clump of illustration</figcaption>
          </figure>
    </div> -->
  </main>
  </Layout>
  
